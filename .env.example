PORT=4000

# PostgreSQL connection string (Neon: Dashboard > Connect > copy the connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

CORS_ORIGIN=https://reelmark-frontend.vercel.app
JWT_SECRET=your_jwt_secret_here
OMDB_API_KEY=replace_with_your_omdb_key

# Admin account, created/updated automatically on every start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_NAME=Admin
